to 'ar_icon' icon {
if (icon == 'Heart') {
return ('[data:unicodeString]' 9829)
}
if (icon == 'Arrow Right') {
return ('[data:unicodeString]' 8594)
}
if (icon == 'Arrow Left') {
return ('[data:unicodeString]' 8592)
}
if (icon == 'Arrow Up') {
return ('[data:unicodeString]' 8593)
}
if (icon == 'Arrow Down') {
return ('[data:unicodeString]' 8595)
}
if (icon == 'Arrow Up Down') {
return ('[data:unicodeString]' 8597)
}
if (icon == 'Diamond') {
return ('[data:unicodeString]' 9830)
}
if (icon == 'Spade') {
return ('[data:unicodeString]' 9824)
}
if (icon == 'Circle Outline') {
return ('[data:unicodeString]' 9675)
}
if (icon == 'Square') {
return ('[data:unicodeString]' 9632)
}
if (icon == 'Bullet') {
return ('[data:unicodeString]' 8226)
}
if (icon == 'Sun Rays') {
return ('[data:unicodeString]' 9788)
}
if (icon == 'Degree') {
return ('[data:unicodeString]' 176)
}
if (icon == 'Plus Minus') {
return ('[data:unicodeString]' 177)
}
if (icon == 'Less Equal') {
return ('[data:unicodeString]' 8804)
}
if (icon == 'Greater Equal') {
return ('[data:unicodeString]' 8805)
}
if (icon == 'Paragraph') {
return ('[data:unicodeString]' 182)
}
if (icon == 'Male') {
return ('[data:unicodeString]' 9794)
}
if (icon == 'Female') {
return ('[data:unicodeString]' 9792)
}
if (icon == 'Music Beamed') {
return ('[data:unicodeString]' 9835)
}
if (icon == 'Micro') {
return ('[data:unicodeString]' 181)
}
if (icon == 'Cent') {
return ('[data:unicodeString]' 162)
}
if (icon == 'Pound') {
return ('[data:unicodeString]' 163)
