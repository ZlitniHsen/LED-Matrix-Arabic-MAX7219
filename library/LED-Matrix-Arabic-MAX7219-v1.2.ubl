to '_ar_glyph' code form {
if (code < 1590) {
return ('_ar_glyph_low' code form)
}
return ('_ar_glyph_high' code form)
}
#############****************##############
to '_ar_glyph_low' code form {
# ASCII symbols used in Arabic text
if (code < 128) {
return ('_ar_glyph_symbol' code)
}

# Arabic comma ،
if (code == 1548) {
return ('[data:makeList]' 0 96 16 0)
}

# Arabic question mark ؟
if (code == 1567) {
return ('[data:makeList]' 6 9 177 2)
}

if (code == 1569) {
return ('_ar_glyph_hamza' form)
}
if (code == 1570) {
return ('_ar_glyph_alif_madda' form)
}
if (code == 1571) {
return ('_ar_glyph_alif_hamza_above' form)
}
if (code == 1572) {
return ('_ar_glyph_waw_hamza' form)
}
if (code == 1573) {
return ('_ar_glyph_alif_hamza_below' form)
}
if (code == 1574) {
return ('_ar_glyph_ya_hamza' form)
}
if (code == 1575) {
return ('_ar_glyph_alif' form)
}
if (code == 1576) {
return ('_ar_glyph_ba' form)
}
if (code == 1577) {
return ('_ar_glyph_teh_marbuta' form)
}
if (code == 1578) {
return ('_ar_glyph_ta' form)
}
if (code == 1579) {
return ('_ar_glyph_tha' form)
}
if (code == 1580) {
return ('_ar_glyph_jeem' form)
}
if (code == 1581) {
return ('_ar_glyph_ha' form)
}
if (code == 1582) {
return ('_ar_glyph_kha' form)
}
if (code == 1583) {
return ('_ar_glyph_dal' form)
}
if (code == 1584) {
return ('_ar_glyph_dhal' form)
}
if (code == 1585) {
return ('_ar_glyph_ra' form)
}
if (code == 1586) {
return ('_ar_glyph_zay' form)
}
if (code == 1587) {
return ('_ar_glyph_seen' form)
}
if (code == 1588) {
return ('_ar_glyph_sheen' form)
}
if (code == 1589) {
return ('_ar_glyph_sad' form)
}

return ('[data:makeList]' 0 0 0)
}
#############****************#################
to '_ar_glyph_high' code form {
if (code == 1590) {
 return ('_ar_glyph_dad' form)
}
if (code == 1591) {
 return ('_ar_glyph_tah' form)
}
if (code == 1592) {
 return ('_ar_glyph_zah' form)
}
if (code == 1593) {
 return ('_ar_glyph_ain' form)
}
if (code == 1594) {
 return ('_ar_glyph_ghain' form)
}
if (code == 1600) {
 return ('_ar_glyph_tatweel' form)
}
if (code == 1601) {
 return ('_ar_glyph_fa' form)
}
if (code == 1602) {
 return ('_ar_glyph_qaf' form)
}
if (code == 1603) {
 return ('_ar_glyph_kaf' form)
}
if (code == 1604) {
 return ('_ar_glyph_lam' form)
}
if (code == 1605) {
 return ('_ar_glyph_meem' form)
}
if (code == 1606) {
 return ('_ar_glyph_noon' form)
}
if (code == 1607) {
 return ('_ar_glyph_ha_heh' form)
}
if (code == 1608) {
 return ('_ar_glyph_waw' form)
}
if (code == 1609) {
 return ('_ar_glyph_alif_maqsura' form)
}
if (code == 1610) {
 return ('_ar_glyph_ya' form)
}
if (code == 1642) {
return ('[data:makeList]' 66 32 16 8 4 66)
}
return ('[data:makeList]' 0 0 0)
}
#############****************##############
to '_ar_glyph_symbol' code {

if (code == 40) {
return ('[data:makeList]' 0 60 66 129 0)
}
# Space
if (code == 32) {
return (newList _ar_spaceWidth 0)
}
# !
if (code == 33) {
return ('[data:makeList]' 95 0)
}
# %
if (code == 37) {
return ('[data:makeList]' 0 66 32 16 8 4 66 0)
}
# )
if (code == 41) {
return ('[data:makeList]' 0 129 66 60 0)
}
# *
if (code == 42) {
return ('[data:makeList]' 0 84 56 254 56 84 0)
}
# +
if (code == 43) {
return ('[data:makeList]' 0 16 16 124 16 16 0)
}
# -
if (code == 45) {
return ('[data:makeList]' 0 32 32 32 32 32 0)
}
# .
if (code == 46) {
return ('[data:makeList]' 32 0)
}
# /
if (code == 47) {
return ('[data:makeList]' 0 64 32 16 8 4 0)
}
# 0
if (code == 48) {
return ('[data:makeList]' 62 81 73 69 62 0)
}
# 1
if (code == 49) {
return ('[data:makeList]' 4 66 127 64 0)
}
# 2
if (code == 50) {
return ('[data:makeList]' 102 81 81 73 70 0)
}
# 3
if (code == 51) {
return ('[data:makeList]' 73 73 73 73 54 0)
}
# 4
if (code == 52) {
return ('[data:makeList]' 31 16 16 124 16 0)
}
# 5
if (code == 53) {
return ('[data:makeList]' 79 73 73 73 49 0)
}
# 6
if (code == 54) {
return ('[data:makeList]' 62 73 73 73 50 0)
}
# 7
if (code == 55) {
return ('[data:makeList]' 1 9 121 13 11 0)
}
# 8
if (code == 56) {
return ('[data:makeList]' 54 73 73 73 54 0)
}
# 9
if (code == 57) {
return ('[data:makeList]' 38 73 73 73 62 0)
}
# =
if (code == 61) {
return ('[data:makeList]' 0 40 40 40 40 40 0)
}
return ('[data:makeList]' 0 0 0)
}
######################################
# ARABIC TEXT COMPOSER
######################################
to '_ar_compose_text' txt {
local 'str' ('[data:toString]' txt)
local 'n' (size str)
# First pass: calculate total graphical width.
local 'totalWidth' 0
local 'i' n
repeatUntil (i < 1) {
local 'code' ('[data:unicodeAt]' i str)
local 'prevCode' 0
local 'nextCode' 0
if (i > 1) {
prevCode = ('[data:unicodeAt]' (i - 1) str)
}
if (i < n) {
nextCode = ('[data:unicodeAt]' (i + 1) str)
}
local 'form' ('_ar_form' prevCode code nextCode)
local 'glyph' ('_ar_glyph' code form)
if (prevCode == 1604) {
if (code == 1575) {
glyph = ('_ar_glyph_lam_alif' form)
i += -1
} (code == 1571) {
glyph = ('_ar_glyph_lam_alif_hamza_above' form)
i += -1
} (code == 1570) {
glyph = ('_ar_glyph_lam_alif_madda' form)
i += -1
} (code == 1573) {
glyph = ('_ar_glyph_lam_alif_hamza_below' form)
i += -1
}
}
totalWidth += (size glyph)
i += -1
}

# Allocate the final list once.
local 'columns' (newList totalWidth 0)
local 'pos' 1

# Second pass: build visual RTL representation.
i = n
repeatUntil (i < 1) {
local 'code' ('[data:unicodeAt]' i str)
local 'prevCode' 0
local 'nextCode' 0
if (i > 1) {
prevCode = ('[data:unicodeAt]' (i - 1) str)
}
if (i < n) {
nextCode = ('[data:unicodeAt]' (i + 1) str)
}
local 'form' ('_ar_form' prevCode code nextCode)
local 'glyph' ('_ar_glyph' code form)
if (prevCode == 1604) {
if (code == 1575) {
glyph = ('_ar_glyph_lam_alif' form)
i += -1
} (code == 1571) {
glyph = ('_ar_glyph_lam_alif_hamza_above' form)
i += -1
} (code == 1570) {
glyph = ('_ar_glyph_lam_alif_madda' form)
i += -1
} (code == 1573) {
glyph = ('_ar_glyph_lam_alif_hamza_below' form)
i += -1
}
}
for c (size glyph) {
atPut pos columns (at c glyph)
pos += 1
}
i += -1
}
return columns
}
##################################
# ARABIC HORIZONTAL FRAMEBUFFER
##################################
to '_ar_screen_to_grid' screen {
local 'width' (_ar_devices * 8)

if (_ar_rotation == 90) {
screen = ('_ar_rotate_screen_90' screen)
} (_ar_rotation == 180) {
screen = ('_ar_rotate_screen_180' screen)
} (_ar_rotation == 270) {
screen = ('_ar_rotate_screen_270' screen)
}

atPut 'all' _ar_grid 0

for x width {
local 'column' (at x screen)
for y 8 {
if (((column >> (y - 1)) & 1) != 0) {
'_ar_set_pixel_buffer' x y true
}
}
}

'_ar_render'
}
##########################################
to 'ar_show_text' txt alignment {
'_ar_ensure_ready'
local 'columns' 0
if ('_ar_group_is_arabic' txt) {
columns = ('_ar_compose_text' txt)
} else {
columns = ('_ar_compose_other' txt)
}
local 'width' (_ar_devices * 8)
local 'screen' (newList width 0)
local 'count' (minimum (size columns) width)
local 'src' 1
if ((size columns) > width) {
src = (((size columns) - width) + 1)
}
local 'dst' ((width - count) + 1)
if ((size columns) <= width) {
if (alignment == 'Left') {
dst = 1
} (alignment == 'Center') {
dst = (((width - count) / 2) + 1)
}
}
for i count {
atPut ((dst + i) - 1) screen (at ((src + i) - 1) columns)
}
'_ar_screen_to_grid' screen
}
###########################################
# BYTE MIRROR HELPER
###########################################
to '_ar_mirror_byte' b {
local 'result' 0
for i 8 {
 if ((b & (1 << (i - 1))) != 0) {
 result = (result | (128 >> (i - 1)))
 }
}
return result
}
############################################
# SCREEN ROTATION
############################################

to 'ar_set_rotation' rot {
'_ar_ensure_ready'
local 'r' ('[data:convertType]' rot 'number')

if (_ar_devices > 1) {
if (r < 180) {
_ar_rotation = 0
} else {
_ar_rotation = 180
}
} else {
if (r == 90) {
_ar_rotation = 90
} (r == 180) {
_ar_rotation = 180
} (r == 270) {
_ar_rotation = 270
} else {
_ar_rotation = 0
}
}
}
#######################################
to '_ar_rotate_screen_180' screen {
local 'width' (size screen)
local 'result' (newList width 0)

for x width {
 local 'src' (at ((width + 1) - x) screen)
 atPut x result ('_ar_mirror_byte' src)
}

return result
}
#/////////////////////
to '_ar_rotate_screen_90' screen {
local 'result' (newList 8 0)
for x 8 {
for y 8 {
if ((((at x screen) >> (y - 1)) & 1) != 0) {
local 'newX' (9 - y)
local 'newY' x
atPut newX result ((at newX result) | (1 << (newY - 1)))
}
}
}
return result
}
#/////////////////////
to '_ar_rotate_screen_270' screen {
local 'result' (newList 8 0)
for x 8 {
for y 8 {
if ((((at x screen) >> (y - 1)) & 1) != 0) {
local 'newX' y
local 'newY' (9 - x)
atPut newX result ((at newX result) | (1 << (newY - 1)))
}
}
}
return result
}
############################################
# GLOBAL LOGICAL PIXEL MAPPING
############################################
to '_ar_pixel_addr' px py {
local 'x' ('[data:convertType]' px 'number')
local 'y' ('[data:convertType]' py 'number')
local 'width' (_ar_devices * 8)

if (or (or (x < 1) (x > width)) (or (y < 1) (y > 8))) {
 return (newList 0 0)
}

local 'logicalDevice' (((x - 1) / 8) + 1)
local 'colInDevice' (((x - 1) % 8) + 1)

local 'physicalDevice' ((_ar_devices - logicalDevice) + 1)

local 'physicalCol' colInDevice
local 'physicalRow' y

if (_ar_type == 'GENERIC') {
 local 'oldCol' physicalCol
 physicalCol = (9 - physicalRow)
 physicalRow = oldCol
}

local 'mask' (128 >> (physicalCol - 1))
local 'gridIdx' (((physicalDevice - 1) * 8) + physicalRow)

return ('[data:makeList]' gridIdx mask)
}
##########################################################
to '_ar_set_pixel_buffer' px py onOff {
local 'addr' ('_ar_pixel_addr' px py)

if ((size addr) == 0) {
 return 0
}

local 'gridIdx' (at 1 addr)
local 'mask' (at 2 addr)
local 'current' (at gridIdx _ar_grid)

if onOff {
 atPut gridIdx _ar_grid (current | mask)
} else {
 atPut gridIdx _ar_grid (current & (255 - mask))
}
}
################################################
to '_ar_shuffle_indices' n {
local 'arr' (newList n 0)
for i n {
atPut i arr i
}
local 'i' n
repeatUntil (i < 2) {
local 'j' (random 1 i)
local 'tmp' (at i arr)
atPut i arr (at j arr)
atPut j arr tmp
i += -1
}
return arr
}
#################################################
to 'ar_text_effect' txt alignment effect showMs {
'_ar_ensure_ready'
if ('_ar_group_is_arabic' txt) {
_ar_effectTarget = ('_ar_compose_text' txt)
} else {
_ar_effectTarget = ('_ar_compose_other' txt)
}
local 'width' (_ar_devices * 8)
local 'count' (minimum (size _ar_effectTarget) width)
local 'src' 1
if ((size _ar_effectTarget) > width) {
src = (((size _ar_effectTarget) - width) + 1)
}
_ar_effectScreen = (newList width 0)

if (and ((size _ar_effectTarget) <= width) (alignment == 'Left')) {
for i count {
atPut i _ar_effectScreen (at ((src + i) - 1) _ar_effectTarget)
}
} (and ((size _ar_effectTarget) <= width) (alignment == 'Center')) {
for i count {
atPut (((((width - count) / 2) + 1) + i) - 1) _ar_effectScreen (at ((src + i) - 1) _ar_effectTarget)
}
} else {
for i count {
atPut (((width - count) + i)) _ar_effectScreen (at ((src + i) - 1) _ar_effectTarget)
}
}

_ar_effectTarget = _ar_effectScreen
if (effect == 'wipe') {
'_ar_wipe_in'
waitMillis (maximum 0 ('[data:convertType]' showMs 'number'))
'_ar_wipe_out'
} (effect == 'row wipe') {
'_ar_row_wipe_in'
waitMillis (maximum 0 ('[data:convertType]' showMs 'number'))
'_ar_row_wipe_out'
} (effect == 'curtain') {
'_ar_curtain_in'
waitMillis (maximum 0 ('[data:convertType]' showMs 'number'))
'_ar_curtain_out'
} else {
_ar_effectScreen = (newList width 0)
local 'order' ('_ar_shuffle_indices' (width * 8))
for k (width * 8) {
local 'idx' ((at k order) - 1)
local 'x' ((idx / 8) + 1)
local 'y' ((idx % 8) + 1)
if ((((at x _ar_effectTarget) >> (y - 1)) & 1) != 0) {
atPut x _ar_effectScreen ((at x _ar_effectScreen) | (1 << (y - 1)))
}
if ((k % _ar_devices) == 0) {
'_ar_screen_to_grid' _ar_effectScreen
waitMillis 2
}
}
'_ar_screen_to_grid' _ar_effectTarget
waitMillis (maximum 0 ('[data:convertType]' showMs 'number'))
'_ar_dissolve_out'
}
}
##############################################################
to '_ar_dissolve_out' {
local 'width' (_ar_devices * 8)
local 'order' ('_ar_shuffle_indices' (width * 8))

for k (width * 8) {
local 'idx' ((at k order) - 1)
local 'x' ((idx / 8) + 1)
local 'y' ((idx % 8) + 1)

atPut x _ar_effectScreen ((at x _ar_effectScreen) & (255 - (1 << (y - 1))))

if ((k % _ar_devices) == 0) {
'_ar_screen_to_grid' _ar_effectScreen
waitMillis 2
}
}

'ar_clear'
}
######################################################
to '_ar_wipe_in' {
local 'width' (_ar_devices * 8)

_ar_effectScreen = (newList width 0)

local 'x' width
repeatUntil (x < 1) {
atPut x _ar_effectScreen (at x _ar_effectTarget)
'_ar_screen_to_grid' _ar_effectScreen
waitMillis 8
x += -1
}
}
#######################################################
to '_ar_wipe_out' {
local 'width' (_ar_devices * 8)

for x width {
atPut x _ar_effectScreen 0
'_ar_screen_to_grid' _ar_effectScreen
waitMillis 8
}

'ar_clear'
}
######################################################
to '_ar_row_wipe_in' {
local 'width' (_ar_devices * 8)

_ar_effectScreen = (newList width 0)

for y 8 {
local 'mask' (1 << (y - 1))

for x width {
atPut x _ar_effectScreen ((at x _ar_effectScreen) | ((at x _ar_effectTarget) & mask))
}

'_ar_screen_to_grid' _ar_effectScreen
waitMillis 60
}
}
######################################################
to '_ar_row_wipe_out' {
local 'width' (_ar_devices * 8)

for y 8 {
local 'mask' (1 << (y - 1))

for x width {
atPut x _ar_effectScreen ((at x _ar_effectScreen) & (255 - mask))
}

'_ar_screen_to_grid' _ar_effectScreen
waitMillis 60
}

'ar_clear'
}
######################################################
to '_ar_curtain_in' {
local 'width' (_ar_devices * 8)

_ar_effectScreen = (newList width 0)

for k 4 {
local 'mask1' (1 << (k - 1))
local 'mask2' (1 << (8 - k))

for x width {
atPut x _ar_effectScreen ((at x _ar_effectScreen) | ((at x _ar_effectTarget) & (mask1 | mask2)))
}

'_ar_screen_to_grid' _ar_effectScreen
waitMillis 100
}
}
######################################################
to '_ar_curtain_out' {
local 'width' (_ar_devices * 8)

for k 4 {
local 'mask1' (1 << (k - 1))
local 'mask2' (1 << (8 - k))

for x width {
atPut x _ar_effectScreen ((at x _ar_effectScreen) & (255 - (mask1 | mask2)))
}

'_ar_screen_to_grid' _ar_effectScreen
waitMillis 100
}

'ar_clear'
}
