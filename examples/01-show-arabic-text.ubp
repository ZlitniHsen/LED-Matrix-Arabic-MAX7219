  return ('[data:makeList]' 128 128 128 64 40)
}

to '_ar_group_is_arabic' txt {
  local 'str' ('[data:toString]' txt)
  local 'n' (size str)
  local 'hasSymbol' false
  if (n < 1) {
    return false
  }
  for i n {
    local 'code' ('[data:unicodeAt]' i str)
    if (code == 32) {
      '#' Ignore spaces.
    } (code == 33) {
      hasSymbol = true
    } (code == 37) {
      hasSymbol = true
    } (code == 40) {
      hasSymbol = true
    } (code == 41) {
      hasSymbol = true
    } (code == 42) {
      hasSymbol = true
    } (code == 43) {
      hasSymbol = true
    } (code == 45) {
      hasSymbol = true
    } (code == 46) {
      hasSymbol = true
    } (code == 47) {
      hasSymbol = true
    } (code == 61) {
      hasSymbol = true
    } (code == 1548) {
      hasSymbol = true
    } (code == 1567) {
      hasSymbol = true
    } else {
      if ('_ar_is_arabic_letter' code) {return true}
      return false
    }
  }
  return hasSymbol
}

to '_ar_group_is_digits' txt {
  local 'str' ('[data:toString]' txt)
  local 'n' (size str)
  if (n < 1) {
    return false
  }
  for i n {
    local 'code' ('[data:unicodeAt]' i str)
    if (code != 32) {
      if (and (code >= 1632) (code <= 1641)) {return true}
      return false
    }
  }
  return false
}

to '_ar_init_hw' clk cs din matrixType maxDevices {
  _ar_clk = clk
  _ar_cs = cs
  _ar_din = din
  _ar_rotation = 0
  _ar_type = matrixType
  _ar_devices = ('[data:convertType]' maxDevices 'number')
  if (not (and (_ar_devices >= 1) (_ar_devices <= 8))) {
    _ar_devices = 1
  }
  _ar_spaceWidth = 3
  _ar_mixedSpaceWidth = 2
  _ar_grid = (newList (_ar_devices * 8) 0)
  setPinMode _ar_clk 'output'
  setPinMode _ar_cs 'output'
  setPinMode _ar_din 'output'
  digitalWriteOp _ar_cs true
  digitalWriteOp _ar_clk false
  _ar_spiBusy = false
  repeat 3 {
    '_ar_write' 12 0
    waitMillis 10
    '_ar_write' 15 0
    '_ar_write' 12 1
    '_ar_write' 9 0
    '_ar_write' 11 7
    '_ar_write' 10 2
    for r 8 {
      '_ar_write' r 0
    }
  }
  _ar_displayOn = true
}

to '_ar_is_arabic_letter' code {
  '#' Main Arabic alphabet: ا .. ي
  if (and (code >= 1575) (code <= 1610)) {
    return true
  }
  '#' Common additional Arabic letters:
  '#' ء آ أ ؤ إ ئ
  if (code == 1569) {
    return true
  } # {
    v ء
  }
  if (code == 1570) {
    return true
  } # {
    v آ
  }
  if (code == 1571) {
    return true
  } # {
    v أ
  }
  if (code == 1572) {
    return true
  } # {
    v ؤ
  }
  if (code == 1573) {
    return true
  } # {
    v إ
  }
  if (code == 1574) {
    return true
  } # {
    v ئ
  }
  if (code == 1600) {
    return true
  } # {
    v ـ
  }
  return false
}

to '_ar_mirror_byte' b {
  local 'result' 0
  for i 8 {
    if ((b & (1 << (i - 1))) != 0) {result = (result | (128 >> (i - 1)))}
  }
  return result
}

to '_ar_other_width' txt {
  if ('_ar_group_is_digits' txt) {return ('_ar_digits_width' txt)}
  return ('_ar_ascii_width' txt)
}

to '_ar_pixel_addr' px py {
  local 'x' ('[data:convertType]' px 'number')
  local 'y' ('[data:convertType]' py 'number')
  local 'width' (_ar_devices * 8)
  if (or (or (x < 1) (x > width)) (or (y < 1) (y > 8))) {
    return (newList 0 0)
  }
  local 'logicalDevice' (((x - 1) / 8) + 1)
  local 'colInDevice' (((x - 1) % 8) + 1)
  local 'physicalDevice' ((_ar_devices - logicalDevice) + 1)
  local 'physicalCol' colInDevice
  local 'physicalRow' y
  if (_ar_type == 'GENERIC') {
    local 'oldCol' physicalCol
    physicalCol = (9 - physicalRow)
    physicalRow = oldCol
  }
  local 'mask' (128 >> (physicalCol - 1))
  local 'gridIdx' (((physicalDevice - 1) * 8) + physicalRow)
  return ('[data:makeList]' gridIdx mask)
}

to '_ar_render' {
  '_ar_spi_lock'
  for r 8 {
    '_ar_send_row_from' r _ar_grid
  }
  '_ar_spi_unlock'
}

to '_ar_rotate_screen_180' screen {
  local 'width' (size screen)
  local 'result' (newList width 0)
  for x width {
    local 'src' (at ((width + 1) - x) screen)
    atPut x result ('_ar_mirror_byte' src)
  }
  return result
}

to '_ar_rotate_screen_270' screen {
  local 'result' (newList 8 0)
  for x 8 {
    for y 8 {
      if ((((at x screen) >> (y - 1)) & 1) != 0) {
        local 'newX' y
        local 'newY' (9 - x)
        atPut newX result ((at newX result) | (1 << (newY - 1)))
      }
    }
  }
  return result
}

to '_ar_rotate_screen_90' screen {
  local 'result' (newList 8 0)
  for x 8 {
    for y 8 {
      if ((((at x screen) >> (y - 1)) & 1) != 0) {
        local 'newX' (9 - y)
        local 'newY' x
        atPut newX result ((at newX result) | (1 << (newY - 1)))
      }
    }
  }
  return result
}

to '_ar_row_wipe_in' {
  local 'width' (_ar_devices * 8)
  _ar_effectScreen = (newList width 0)
  for y 8 {
    local 'mask' (1 << (y - 1))
    for x width {
      atPut x _ar_effectScreen ((at x _ar_effectScreen) | ((at x _ar_effectTarget) & mask))
    }
    '_ar_screen_to_grid' _ar_effectScreen
    waitMillis 60
  }
}

to '_ar_row_wipe_out' {
  local 'width' (_ar_devices * 8)
  for y 8 {
    local 'mask' (1 << (y - 1))
    for x width {
      atPut x _ar_effectScreen ((at x _ar_effectScreen) & (255 - mask))
    }
    '_ar_screen_to_grid' _ar_effectScreen
    waitMillis 60
  }
  ar_clear
}

to '_ar_scan_modules' {
  local 'w' (_ar_devices * 8)
  for d _ar_devices {
    '#' Start each step with a completely clear display.
    atPut 'all' _ar_grid 0
    '#' Show the previous module number.
    if (d > 1) {
      local 'previous' (d - 1)
      local 'previousLeft' ((w - (previous * 8)) + 1)
      local 'char' ('[data:toString]' previous)
      local 'shape' ('[misc:shapeforChar]' char)
      local 'startX' (previousLeft + 2)
      for c 5 {
        local 'col' (at c shape)
        for y 8 {
          if (((col >> (y - 1)) & 1) != 0) {'_ar_scan_pixel' ((startX + c) - 1) y true}
        }
      }
    }
    '#' Light the current module completely.
    local 'moduleLeft' ((w - (d * 8)) + 1)
    for x 8 {
      for y 8 {
        '_ar_scan_pixel' ((moduleLeft + x) - 1) y true
      }
    }
    '_ar_render'
    waitMillis 300
  }
  '#' Final step: show only the last module number.
  atPut 'all' _ar_grid 0
  local 'char' ('[data:toString]' _ar_devices)
  local 'shape' ('[misc:shapeforChar]' char)
  local 'moduleLeft' ((w - (_ar_devices * 8)) + 1)
  local 'startX' (moduleLeft + 2)
  for c 5 {
    local 'col' (at c shape)
    for y 8 {
      if (((col >> (y - 1)) & 1) != 0) {'_ar_scan_pixel' ((startX + c) - 1) y true}
    }
  }
  '_ar_render'
  waitMillis 200
  '#' Final clear.
  atPut 'all' _ar_grid 0
  '_ar_render'
}

to '_ar_scan_pixel' x y onOff {
  if (_ar_rotation == 90) {
    '_ar_set_pixel_buffer' (9 - y) x onOff
  } (_ar_rotation == 180) {
    '_ar_set_pixel_buffer' (((_ar_devices * 8) + 1) - x) (9 - y) onOff
  } (_ar_rotation == 270) {
    '_ar_set_pixel_buffer' y (9 - x) onOff
  } else {
    '_ar_set_pixel_buffer' x y onOff
  }
}

to '_ar_screen_to_grid' screen {
  local 'width' (_ar_devices * 8)
  if (_ar_rotation == 90) {
    screen = ('_ar_rotate_screen_90' screen)
  } (_ar_rotation == 180) {
    screen = ('_ar_rotate_screen_180' screen)
  } (_ar_rotation == 270) {
    screen = ('_ar_rotate_screen_270' screen)
  }
  atPut 'all' _ar_grid 0
  for x width {
    local 'column' (at x screen)
    for y 8 {
      if (((column >> (y - 1)) & 1) != 0) {'_ar_set_pixel_buffer' x y true}
    }
  }
  '_ar_render'
}

to '_ar_scroll_columns_ltr' columns delayMs {
  local 'textWidth' (size columns)
  local 'width' (_ar_devices * 8)
  local 'delayValue' ('[data:convertType]' delayMs 'number')
  delayValue = (maximum 5 (minimum 500 delayValue))
  if (textWidth < 1) {
    ar_clear
    return 0
  }
  '#' Arabic scrolling direction:
  '#' text starts outside the left side and moves to the right.
  local 'leftX' (1 - textWidth)
  repeatUntil (leftX > (width + 1)) {
    local 'screen' (newList width 0)
    for x width {
      local 'src' ((x - leftX) + 1)
      if (and (src >= 1) (src <= textWidth)) {
        atPut x screen (at src columns)
      }
    }
    '_ar_screen_to_grid' screen
    waitMillis delayValue
    leftX += 1
  }
  ar_clear
}

to '_ar_scroll_columns_rtl' columns delayMs {
  local 'textWidth' (size columns)
  local 'width' (_ar_devices * 8)
  local 'delayValue' ('[data:convertType]' delayMs 'number')
  delayValue = (maximum 5 (minimum 500 delayValue))
  if (textWidth < 1) {
    ar_clear
    return 0
  }
  '#' Text starts outside the right side and moves to the left.
  local 'leftX' (width + 1)
  repeatUntil (leftX < (1 - textWidth)) {
    local 'screen' (newList width 0)
    for x width {
      local 'src' ((x - leftX) + 1)
      if (and (src >= 1) (src <= textWidth)) {
        atPut x screen (at src columns)
      }
    }
    '_ar_screen_to_grid' screen
    waitMillis delayValue
    leftX += -1
  }
  ar_clear
}

to '_ar_send_row_from' row frame {
  digitalWriteOp _ar_cs false
  local 'd' _ar_devices
  repeatUntil (d < 1) {
    local 'gridIdx' (((d - 1) * 8) + row)
    '_ar_spi_send' row
    '_ar_spi_send' (at gridIdx frame)
    d += -1
  }
  digitalWriteOp _ar_cs true
}

to '_ar_set_pixel_buffer' px py onOff {
  local 'addr' ('_ar_pixel_addr' px py)
  if ((size addr) == 0) {
    return 0
  }
  local 'gridIdx' (at 1 addr)
  local 'mask' (at 2 addr)
  local 'current' (at gridIdx _ar_grid)
  if onOff {
    atPut gridIdx _ar_grid (current | mask)
  } else {
    atPut gridIdx _ar_grid (current & (255 - mask))
  }
}

to '_ar_shuffle_indices' n {
  local 'arr' (newList n 0)
  for i n {
    atPut i arr i
  }
  local 'i' n
  repeatUntil (i < 2) {
    local 'j' (random 1 i)
    local 'tmp' (at i arr)
    atPut i arr (at j arr)
    atPut j arr tmp
    i += -1
  }
  return arr
}

to '_ar_spi_lock' {
  repeatUntil (not _ar_spiBusy) {
    waitMillis 1
  }
  _ar_spiBusy = true
}

to '_ar_spi_send' byte {
  local 'mask' 128
  repeat 8 {
    digitalWriteOp _ar_clk false
    digitalWriteOp _ar_din ((byte & mask) != 0)
    digitalWriteOp _ar_clk true
    mask = (mask >> 1)
  }
}

to '_ar_spi_unlock' {
  _ar_spiBusy = false
}

to '_ar_text_width' txt {
  local 'str' ('[data:toString]' txt)
  local 'n' (size str)
  local 'totalWidth' 0
  local 'i' n
  repeatUntil (i < 1) {
    local 'code' ('[data:unicodeAt]' i str)
    local 'prevCode' 0
    local 'nextCode' 0
    if (i > 1) {
      prevCode = ('[data:unicodeAt]' (i - 1) str)
    }
    if (i < n) {
      nextCode = ('[data:unicodeAt]' (i + 1) str)
    }
    local 'form' ('_ar_form' prevCode code nextCode)
    local 'glyph' ('_ar_glyph' code form)
    if (prevCode == 1604) {
      if (code == 1575) {
        glyph = ('_ar_glyph_lam_alif' form)
        i += -1
      } (code == 1571) {
        glyph = ('_ar_glyph_lam_alif_hamza_above' form)
        i += -1
      } (code == 1570) {
        glyph = ('_ar_glyph_lam_alif_madda' form)
        i += -1
      } (code == 1573) {
        glyph = ('_ar_glyph_lam_alif_hamza_below' form)
        i += -1
      }
    }
    totalWidth += (size glyph)
    i += -1
  }
  return totalWidth
}

to '_ar_wipe_in' {
  local 'width' (_ar_devices * 8)
  _ar_effectScreen = (newList width 0)
  local 'x' width
  repeatUntil (x < 1) {
    atPut x _ar_effectScreen (at x _ar_effectTarget)
    '_ar_screen_to_grid' _ar_effectScreen
    waitMillis 8
    x += -1
  }
}

to '_ar_wipe_out' {
  local 'width' (_ar_devices * 8)
  for x width {
    atPut x _ar_effectScreen 0
    '_ar_screen_to_grid' _ar_effectScreen
    waitMillis 8
  }
  ar_clear
}

to '_ar_write' reg val {
  '_ar_spi_lock'
  digitalWriteOp _ar_cs false
  for d _ar_devices {
    '_ar_spi_send' reg
    '_ar_spi_send' val
  }
  digitalWriteOp _ar_cs true
  '_ar_spi_unlock'
}

to ar_blink_text txt alignment onMs offMs repeatCount {
  '_ar_ensure_ready'
  local 'columns' 0
  if ('_ar_group_is_arabic' txt) {
    columns = ('_ar_compose_text' txt)
  } else {
    columns = ('_ar_compose_other' txt)
  }
  local 'width' (_ar_devices * 8)
  local 'screen' (newList width 0)
  local 'count' (minimum (size columns) width)
  local 'src' 1
  if ((size columns) > width) {
    src = (((size columns) - width) + 1)
  }
  local 'dst' ((width - count) + 1)
  if ((size columns) <= width) {
    if (alignment == 'Left') {
      dst = 1
    } (alignment == 'Center') {
      dst = (((width - count) / 2) + 1)
    }
  }
  for i count {
    atPut ((dst + i) - 1) screen (at ((src + i) - 1) columns)
  }
  local 'n' ('[data:convertType]' repeatCount 'number')
  n = (maximum 0 n)
  repeat n {
    '_ar_screen_to_grid' screen
    waitMillis (maximum 0 ('[data:convertType]' onMs 'number'))
    atPut 'all' _ar_grid 0
    '_ar_render'
    waitMillis (maximum 0 ('[data:convertType]' offMs 'number'))
  }
}

to ar_clear {
  '_ar_ensure_ready'
  atPut 'all' _ar_grid 0
  '_ar_render'
}

to ar_digits value {
  local 'str' ('[data:toString]' value)
  local 'result' ''
  for i (size str) {
    local 'code' ('[data:unicodeAt]' i str)
    if (and (code >= 48) (code <= 57)) {
      result = ('[data:join]' result ('[data:unicodeString]' (code + 1584)))
    } else {
      result = ('[data:join]' result ('[data:copyFromTo]' str i i))
    }
  }
  return result
}

to ar_display_power state {
  '_ar_ensure_ready'
  if (state == 'On') {
    if (not _ar_displayOn) {
      '_ar_write' 12 1
      _ar_displayOn = true
    }
  } else {
    if _ar_displayOn {
      '_ar_write' 12 0
      _ar_displayOn = false
    }
  }
}

to ar_icon icon {
  if (icon == 'Heart') {return ('[data:unicodeString]' 9829)}
  if (icon == 'Arrow Right') {return ('[data:unicodeString]' 8594)}
  if (icon == 'Arrow Left') {return ('[data:unicodeString]' 8592)}
  if (icon == 'Arrow Up') {return ('[data:unicodeString]' 8593)}
  if (icon == 'Arrow Down') {return ('[data:unicodeString]' 8595)}
  if (icon == 'Arrow Up Down') {return ('[data:unicodeString]' 8597)}
  if (icon == 'Diamond') {return ('[data:unicodeString]' 9830)}
  if (icon == 'Spade') {return ('[data:unicodeString]' 9824)}
  if (icon == 'Circle Outline') {return ('[data:unicodeString]' 9675)}
  if (icon == 'Square') {return ('[data:unicodeString]' 9632)}
  if (icon == 'Bullet') {return ('[data:unicodeString]' 8226)}
  if (icon == 'Sun Rays') {return ('[data:unicodeString]' 9788)}
  if (icon == 'Degree') {return ('[data:unicodeString]' 176)}
  if (icon == 'Plus Minus') {return ('[data:unicodeString]' 177)}
  if (icon == 'Less Equal') {return ('[data:unicodeString]' 8804)}
  if (icon == 'Greater Equal') {return ('[data:unicodeString]' 8805)}
  if (icon == 'Paragraph') {return ('[data:unicodeString]' 182)}
  if (icon == 'Male') {return ('[data:unicodeString]' 9794)}
  if (icon == 'Female') {return ('[data:unicodeString]' 9792)}
  if (icon == 'Music Beamed') {return ('[data:unicodeString]' 9835)}
  if (icon == 'Micro') {return ('[data:unicodeString]' 181)}
  if (icon == 'Cent') {return ('[data:unicodeString]' 162)}
  if (icon == 'Pound') {return ('[data:unicodeString]' 163)}
  if (icon == 'Yen') {return ('[data:unicodeString]' 165)}
  return ''
}

to ar_init clk cs din matrixType maxDevices {
  _ar_initState = 1
  '_ar_init_hw' clk cs din matrixType maxDevices
  _ar_initState = 2
}

to ar_scroll_mixed delayMs group1 group2 group3 group4 group5 {
  '_ar_ensure_ready'
  local 'totalWidth' 0
  local 'pos' 0
  if ((size group1) > 0) {
    if ('_ar_group_is_arabic' group1) {
      totalWidth += ('_ar_text_width' group1)
    } else {
      totalWidth += ('_ar_other_width' group1)
    }
    pos += 1
  }
  if ((size group2) > 0) {
    if ('_ar_group_is_arabic' group2) {
      totalWidth += ('_ar_text_width' group2)
    } else {
      totalWidth += ('_ar_other_width' group2)
    }
    pos += 1
  }
  if ((size group3) > 0) {
    if ('_ar_group_is_arabic' group3) {
      totalWidth += ('_ar_text_width' group3)
    } else {
      totalWidth += ('_ar_other_width' group3)
    }
    pos += 1
  }
  if ((size group4) > 0) {
    if ('_ar_group_is_arabic' group4) {
      totalWidth += ('_ar_text_width' group4)
    } else {
      totalWidth += ('_ar_other_width' group4)
    }
    pos += 1
  }
  if ((size group5) > 0) {
    if ('_ar_group_is_arabic' group5) {
      totalWidth += ('_ar_text_width' group5)
    } else {
      totalWidth += ('_ar_other_width' group5)
    }
    pos += 1
  }
  if (pos > 1) {
    totalWidth += ((pos - 1) * _ar_mixedSpaceWidth)
  }
  _ar_mixedBuffer = (newList totalWidth 0)
  pos = 1
  local 'columns' 0
  '#' Visual order: group5 '|' group4 '|' group3 '|' group2 '|' group1
  if ((size group5) > 0) {
    if ('_ar_group_is_arabic' group5) {
      columns = ('_ar_compose_text' group5)
    } else {
      columns = ('_ar_compose_other' group5)
    }
    for c (size columns) {
      atPut pos _ar_mixedBuffer (at c columns)
      pos += 1
    }
  }
  if ((size group4) > 0) {
    if (pos > 1) {pos += _ar_mixedSpaceWidth}
    if ('_ar_group_is_arabic' group4) {
      columns = ('_ar_compose_text' group4)
    } else {
      columns = ('_ar_compose_other' group4)
    }
    for c (size columns) {
      atPut pos _ar_mixedBuffer (at c columns)
      pos += 1
    }
  }
  if ((size group3) > 0) {
    if (pos > 1) {pos += _ar_mixedSpaceWidth}
    if ('_ar_group_is_arabic' group3) {
      columns = ('_ar_compose_text' group3)
    } else {
      columns = ('_ar_compose_other' group3)
    }
    for c (size columns) {
      atPut pos _ar_mixedBuffer (at c columns)
      pos += 1
    }
  }
  if ((size group2) > 0) {
    if (pos > 1) {pos += _ar_mixedSpaceWidth}
    if ('_ar_group_is_arabic' group2) {
      columns = ('_ar_compose_text' group2)
    } else {
      columns = ('_ar_compose_other' group2)
    }
    for c (size columns) {
      atPut pos _ar_mixedBuffer (at c columns)
      pos += 1
    }
  }
  if ((size group1) > 0) {
    if (pos > 1) {pos += _ar_mixedSpaceWidth}
    if ('_ar_group_is_arabic' group1) {
      columns = ('_ar_compose_text' group1)
    } else {
      columns = ('_ar_compose_other' group1)
    }
    for c (size columns) {
      atPut pos _ar_mixedBuffer (at c columns)
      pos += 1
    }
  }
  '_ar_scroll_columns_ltr' _ar_mixedBuffer delayMs
}

to ar_scroll_text txt direction delayMs {
  '_ar_ensure_ready'
  local 'columns' 0
  local 'isArabic' ('_ar_group_is_arabic' txt)
  if isArabic {
    columns = ('_ar_compose_text' txt)
  } else {
    columns = ('_ar_compose_other' txt)
  }
  if (direction == 'LTR') {
    '_ar_scroll_columns_ltr' columns delayMs
  } (direction == 'RTL') {
    '_ar_scroll_columns_rtl' columns delayMs
  } else {
    if isArabic {
      '_ar_scroll_columns_ltr' columns delayMs
    } else {
      '_ar_scroll_columns_rtl' columns delayMs
    }
  }
}

to ar_set_brightness level {
  '_ar_ensure_ready'
  local 'value' ('[data:convertType]' level 'number')
  value = (maximum 0 (minimum 15 value))
  '_ar_write' 10 value
}

to ar_set_rotation rot {
  '_ar_ensure_ready'
  local 'r' ('[data:convertType]' rot 'number')
  if (_ar_devices > 1) {
    if (r < 180) {
      _ar_rotation = 0
    } else {
      _ar_rotation = 180
    }
  } else {
    if (r == 90) {
      _ar_rotation = 90
    } (r == 180) {
      _ar_rotation = 180
    } (r == 270) {
      _ar_rotation = 270
    } else {
      _ar_rotation = 0
    }
  }
}

to ar_show_mixed group1 group2 group3 group4 group5 {
  '_ar_ensure_ready'
  local 'width' (_ar_devices * 8)
  local 'screen' (newList width 0)
  local 'x' width
  local 'columns' 0
  local 'hasPrevious' false
  '#' Group 1
  if ((size group1) > 0) {
    if ('_ar_group_is_digits' group1) {
      columns = ('_ar_compose_digits' group1)
    } ('_ar_group_is_arabic' group1) {
      columns = ('_ar_compose_text' group1)
    } else {
      columns = ('_ar_compose_ascii' group1)
    }
    x = ((x - (size columns)) + 1)
    for c (size columns) {
      if (and (x >= 1) (x <= width)) {atPut x screen (at c columns)}
      x += 1
    }
    x = (x - (size columns))
    x += -1
    hasPrevious = true
  }
  '#' Group 2
  if ((size group2) > 0) {
    if hasPrevious {x += (0 - _ar_mixedSpaceWidth)}
    if ('_ar_group_is_digits' group2) {
      columns = ('_ar_compose_digits' group2)
    } ('_ar_group_is_arabic' group2) {
      columns = ('_ar_compose_text' group2)
    } else {
      columns = ('_ar_compose_ascii' group2)
    }
    x = ((x - (size columns)) + 1)
    for c (size columns) {
      if (and (x >= 1) (x <= width)) {atPut x screen (at c columns)}
      x += 1
    }
    x = (x - (size columns))
    x += -1
    hasPrevious = true
  }
  '#' Group 3
  if ((size group3) > 0) {
    if hasPrevious {x += (0 - _ar_mixedSpaceWidth)}
    if ('_ar_group_is_digits' group3) {
      columns = ('_ar_compose_digits' group3)
    } ('_ar_group_is_arabic' group3) {
      columns = ('_ar_compose_text' group3)
    } else {
      columns = ('_ar_compose_ascii' group3)
    }
    x = ((x - (size columns)) + 1)
    for c (size columns) {
      if (and (x >= 1) (x <= width)) {atPut x screen (at c columns)}
      x += 1
    }
    x = (x - (size columns))
    x += -1
    hasPrevious = true
  }
  '#' Group 4
  if ((size group4) > 0) {
    if hasPrevious {x += (0 - _ar_mixedSpaceWidth)}
    if ('_ar_group_is_digits' group4) {
      columns = ('_ar_compose_digits' group4)
    } ('_ar_group_is_arabic' group4) {
      columns = ('_ar_compose_text' group4)
    } else {
      columns = ('_ar_compose_ascii' group4)
    }
    x = ((x - (size columns)) + 1)
    for c (size columns) {
      if (and (x >= 1) (x <= width)) {atPut x screen (at c columns)}
      x += 1
    }
    x = (x - (size columns))
    x += -1
    hasPrevious = true
  }
  '#' Group 5
  if ((size group5) > 0) {
    if hasPrevious {x += (0 - _ar_mixedSpaceWidth)}
    if ('_ar_group_is_digits' group5) {
      columns = ('_ar_compose_digits' group5)
    } ('_ar_group_is_arabic' group5) {
      columns = ('_ar_compose_text' group5)
    } else {
      columns = ('_ar_compose_ascii' group5)
    }
    x = ((x - (size columns)) + 1)
    for c (size columns) {
      if (and (x >= 1) (x <= width)) {atPut x screen (at c columns)}
      x += 1
    }
  }
  '_ar_screen_to_grid' screen
}

to ar_show_text txt alignment {
  '_ar_ensure_ready'
  local 'columns' 0
  if ('_ar_group_is_arabic' txt) {
    columns = ('_ar_compose_text' txt)
  } else {
    columns = ('_ar_compose_other' txt)
  }
  local 'width' (_ar_devices * 8)
  local 'screen' (newList width 0)
  local 'count' (minimum (size columns) width)
  local 'src' 1
  if ((size columns) > width) {
    src = (((size columns) - width) + 1)
  }
  local 'dst' ((width - count) + 1)
  if ((size columns) <= width) {
    if (alignment == 'Left') {
      dst = 1
    } (alignment == 'Center') {
      dst = (((width - count) / 2) + 1)
    }
  }
  for i count {
    atPut ((dst + i) - 1) screen (at ((src + i) - 1) columns)
  }
  '_ar_screen_to_grid' screen
}

to ar_test {
  '_ar_ensure_ready'
  local 'w' (_ar_devices * 8)
  '#' Phase 1 : four logical corners.
  atPut 'all' _ar_grid 0
  '_ar_scan_pixel' 1 1 true
  '_ar_scan_pixel' w 1 true
  '_ar_scan_pixel' 1 8 true
  '_ar_scan_pixel' w 8 true
  '_ar_render'
  waitMillis 500
  '#' Clear.
  atPut 'all' _ar_grid 0
  '_ar_render'
  '#---------------------------'
  '#' Phase 2 : horizontal sweep.
  for y 8 {
    for x w {
      '_ar_scan_pixel' x y true
    }
    '_ar_render'
    waitMillis 35
    for x w {
      '_ar_scan_pixel' x y false
    }
  }
  '#---------------------------'
  '#' Phase 3 : vertical sweep.
  for x w {
    for y 8 {
      '_ar_scan_pixel' x y true
    }
    '_ar_render'
    waitMillis 20
    for y 8 {
      '_ar_scan_pixel' x y false
    }
  }
  '#' Clear before module identification.
  atPut 'all' _ar_grid 0
  '_ar_render'
  waitMillis 200
  '#---------------------------'
  '#' Phase 4 : progressive module identification.
  '_ar_scan_modules'
}

to ar_text_effect txt alignment effect showMs {
  '_ar_ensure_ready'
  if ('_ar_group_is_arabic' txt) {
    _ar_effectTarget = ('_ar_compose_text' txt)
  } else {
    _ar_effectTarget = ('_ar_compose_other' txt)
  }
  local 'width' (_ar_devices * 8)
  local 'count' (minimum (size _ar_effectTarget) width)
  local 'src' 1
  if ((size _ar_effectTarget) > width) {
    src = (((size _ar_effectTarget) - width) + 1)
  }
  _ar_effectScreen = (newList width 0)
  if (and ((size _ar_effectTarget) <= width) (alignment == 'Left')) {
    for i count {
      atPut i _ar_effectScreen (at ((src + i) - 1) _ar_effectTarget)
    }
  } (and ((size _ar_effectTarget) <= width) (alignment == 'Center')) {
    for i count {
      atPut (((((width - count) / 2) + 1) + i) - 1) _ar_effectScreen (at ((src + i) - 1) _ar_effectTarget)
    }
  } else {
    for i count {
      atPut ((width - count) + i) _ar_effectScreen (at ((src + i) - 1) _ar_effectTarget)
    }
  }
  _ar_effectTarget = _ar_effectScreen
  if (effect == 'wipe') {
    '_ar_wipe_in'
    waitMillis (maximum 0 ('[data:convertType]' showMs 'number'))
    '_ar_wipe_out'
  } (effect == 'row wipe') {
    '_ar_row_wipe_in'
    waitMillis (maximum 0 ('[data:convertType]' showMs 'number'))
    '_ar_row_wipe_out'
  } (effect == 'curtain') {
    '_ar_curtain_in'
    waitMillis (maximum 0 ('[data:convertType]' showMs 'number'))
    '_ar_curtain_out'
  } else {
    _ar_effectScreen = (newList width 0)
    local 'order' ('_ar_shuffle_indices' (width * 8))
    for k (width * 8) {
      local 'idx' ((at k order) - 1)
      local 'x' ((idx / 8) + 1)
      local 'y' ((idx % 8) + 1)
      if ((((at x _ar_effectTarget) >> (y - 1)) & 1) != 0) {
        atPut x _ar_effectScreen ((at x _ar_effectScreen) | (1 << (y - 1)))
      }
      if ((k % _ar_devices) == 0) {
        '_ar_screen_to_grid' _ar_effectScreen
        waitMillis 2
      }
    }
    '_ar_screen_to_grid' _ar_effectTarget
    waitMillis (maximum 0 ('[data:convertType]' showMs 'number'))
    '_ar_dissolve_out'
  }
}


module WiFi Comm
author MicroBlocks
version 1 10 
tags communication network 
description 'Connect to a WiFi network. Used in conjunction with other network libraries, such as HTTP client, HTTP server or Web Thing.
'

  spec ' ' 'wifiConnect' 'wifi connect to _ password _ : IP _ gateway _ subnet _' 'str str auto auto auto' 'Network_Name' '' '192.168.1.42' '192.168.1.1' '255.255.255.0'
  spec ' ' 'wifiCreateHotspot' 'wifi create hotspot _ password _' 'str str' 'Network_Name' 'Network_Password'
  spec ' ' '[net:stopWiFi]' 'stop wifi'
  space
  spec ' ' '[net:setDomainName]' 'wifi set local domain name _ .local' 'str' 'microblocks'
  space
  spec 'r' 'getIPAddress' 'IP address'
  spec 'r' '[net:myMAC]' 'MAC address'
  space
  spec ' ' '[net:allowWiFiAndBLE]' 'allow WiFi while using BLE _' 'bool' true

to getIPAddress {
  return ('[net:myIPAddress]')
}

to wifiConnect ssid password fixedIP gatewayIP subnetIP {
  if (not ('[net:hasWiFi]')) {return}
  '[net:stopWiFi]'
  if ((pushArgCount) < 5) {
    '[net:startWiFi]' ssid password
  } else {
    '[net:startWiFi]' ssid password false fixedIP gatewayIP subnetIP
  }
  local 'startMSecs' (millisOp)
  repeatUntil (('[net:myIPAddress]') != '0.0.0.0') {
    comment 'Timeout after N seconds'
    if (((millisOp) - startMSecs) > 30000) {
      sayIt 'Could not connect'
      return 0
    }
    comment 'Slow blink while trying to connect'
    setUserLED true
    waitMillis 300
    setUserLED false
    waitMillis 300
  }
  repeat 6 {
    comment 'Quick blinks when connected'
    setUserLED true
    waitMillis 50
    setUserLED false
    waitMillis 50
  }
  '[net:setDomainName]' 'microblocks'
  sayIt 'My IP address is:' ('[net:myIPAddress]')
}

to wifiCreateHotspot ssid password {
  if (not ('[net:hasWiFi]')) {return}
  if ((size password) < 8) {
    sayIt 'Password must be at least 8 characters'
    return 0
  }
  '[net:startWiFi]' ssid password true
  if ('Connected' != ('[net:wifiStatus]')) {
    sayIt 'Could not create hotspot'
    return 0
  }
  repeat 6 {
    comment 'Quick blinks when connected'
    setUserLED true
    waitMillis 50
    setUserLED false
    waitMillis 50
  }
  '[net:setDomainName]' 'microblocks'
  sayIt 'My IP address is:' ('[net:myIPAddress]')
}

