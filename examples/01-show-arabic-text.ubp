to '_ar_glyph_digit' code {
  if (code == 44) {return ('[data:makeList]' 128 64)}
  if (code == 46) {return ('[data:makeList]' 128)}
  if (code == 1632) {return ('[data:makeList]' 8 28 8)}
  if (code == 1633) {return ('[data:makeList]' 127)}
  if (code == 1634) {return ('[data:makeList]' 71 58 2 2 1)}
  if (code == 1635) {return ('[data:makeList]' 71 58 3 2 3)}
  if (code == 1636) {return ('[data:makeList]' 54 73 73)}
  if (code == 1637) {return ('[data:makeList]' 62 65 65 66 60)}
  if (code == 1638) {return ('[data:makeList]' 1 2 2 58 71)}
  if (code == 1639) {return ('[data:makeList]' 15 24 96 24 15)}
  if (code == 1640) {return ('[data:makeList]' 120 12 3 12 120)}
  if (code == 1641) {return ('[data:makeList]' 6 9 10 124)}
  if (code == 37) {return ('[data:makeList]' 66 32 16 8 4 66)}
  return ('[data:makeList]' 0 0 0)
}

