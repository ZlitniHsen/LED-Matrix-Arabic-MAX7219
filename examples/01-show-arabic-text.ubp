  '#' isolated '&' final
  if (or (form == 0) (form == 3)) {
    return ('[data:makeList]' 32 64 192 64 216 36 4 24)
  }
  '#' initial
  if (form == 1) {
    return ('[data:makeList]' 32 160 32 184)
  }
  '#' medial
  return ('[data:makeList]' 32 160 56 160)
}

to '_ar_glyph_ya_hamza' form {
