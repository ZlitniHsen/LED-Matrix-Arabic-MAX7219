to '_ar_glyph_low' code form {
  '#' ASCII symbols used in Arabic text
  if (code < 128) {
    return ('_ar_glyph_symbol' code)
  }
  '#' Arabic comma ،
  if (code == 1548) {
    return ('[data:makeList]' 0 96 16 0)
  }
  '#' Arabic question mark ؟
  if (code == 1567) {
    return ('[data:makeList]' 6 9 177 2)
  }
  if (code == 1569) {
    return ('_ar_glyph_hamza' form)
  }
  if (code == 1570) {
    return ('_ar_glyph_alif_madda' form)
  }
  if (code == 1571) {
    return ('_ar_glyph_alif_hamza_above' form)
  }
  if (code == 1572) {
    return ('_ar_glyph_waw_hamza' form)
  }
  if (code == 1573) {
    return ('_ar_glyph_alif_hamza_below' form)
  }
  if (code == 1574) {
    return ('_ar_glyph_ya_hamza' form)
  }
  if (code == 1575) {
    return ('_ar_glyph_alif' form)
  }
  if (code == 1576) {
    return ('_ar_glyph_ba' form)
  }
  if (code == 1577) {
    return ('_ar_glyph_teh_marbuta' form)
  }
  if (code == 1578) {
    return ('_ar_glyph_ta' form)
  }
  if (code == 1579) {
    return ('_ar_glyph_tha' form)
  }
  if (code == 1580) {
    return ('_ar_glyph_jeem' form)
  }
  if (code == 1581) {
    return ('_ar_glyph_ha' form)
  }
  if (code == 1582) {
    return ('_ar_glyph_kha' form)
  }
  if (code == 1583) {
    return ('_ar_glyph_dal' form)
  }
  if (code == 1584) {
    return ('_ar_glyph_dhal' form)
  }
  if (code == 1585) {
    return ('_ar_glyph_ra' form)
  }
  if (code == 1586) {
    return ('_ar_glyph_zay' form)
  }
  if (code == 1587) {
    return ('_ar_glyph_seen' form)
  }
  if (code == 1588) {
    return ('_ar_glyph_sheen' form)
  }
  if (code == 1589) {
    return ('_ar_glyph_sad' form)
  }
  return ('[data:makeList]' 0 0 0)
}

