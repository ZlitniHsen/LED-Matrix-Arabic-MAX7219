to '_ar_glyph_test' {
  '_ar_ensure_ready'
  '#' Exact 8 x8 matrix test
  local 'glyph' ('[data:makeList]' 0 0 0 0 3 52 40 55)
  local 'width' (_ar_devices * 8)
  local 'screen' (newList width 0)
  local 'start' ((width - (size glyph)) + 1)
  for i (size glyph) {
    atPut ((start + i) - 1) screen (at i glyph)
  }
  '_ar_screen_to_grid' screen
}

