to '_ar_glyph_symbol' code {
  if (code == 40) {return ('[data:makeList]' 0 60 66 129 0)}
  '#' Space
  if (code == 32) {
    return (newList _ar_spaceWidth 0)
  }
  '#' !
  if (code == 33) {
    return ('[data:makeList]' 95 0)
  }
  '#' '%'
  if (code == 37) {
    return ('[data:makeList]' 0 66 32 16 8 4 66 0)
  }
  '#'
  if (code == 41) {
    return ('[data:makeList]' 0 129 66 60 0)
  }
  '#' '*'
  if (code == 42) {
    return ('[data:makeList]' 0 84 56 254 56 84 0)
  }
  '#' '+'
  if (code == 43) {
    return ('[data:makeList]' 0 16 16 124 16 16 0)
  }
  '#' '-'
  if (code == 45) {
    return ('[data:makeList]' 0 32 32 32 32 32 0)
  }
  '#' .
  if (code == 46) {
    return ('[data:makeList]' 32 0)
  }
  '#' '/'
  if (code == 47) {
    return ('[data:makeList]' 0 64 32 16 8 4 0)
  }
  '#' 0
  if (code == 48) {
    return ('[data:makeList]' 62 81 73 69 62 0)
  }
  '#' 1
  if (code == 49) {
    return ('[data:makeList]' 4 66 127 64 0)
  }
  '#' 2
  if (code == 50) {
    return ('[data:makeList]' 102 81 81 73 70 0)
  }
  '#' 3
  if (code == 51) {
    return ('[data:makeList]' 73 73 73 73 54 0)
  }
  '#' 4
  if (code == 52) {
    return ('[data:makeList]' 31 16 16 124 16 0)
  }
  '#' 5
  if (code == 53) {
    return ('[data:makeList]' 79 73 73 73 49 0)
  }
  '#' 6
  if (code == 54) {
    return ('[data:makeList]' 62 73 73 73 50 0)
  }
  '#' 7
  if (code == 55) {
    return ('[data:makeList]' 1 9 121 13 11 0)
  }
  '#' 8
  if (code == 56) {
    return ('[data:makeList]' 54 73 73 73 54 0)
  }
  '#' 9
  if (code == 57) {
    return ('[data:makeList]' 38 73 73 73 62 0)
  }
  '#' '='
  if (code == 61) {
    return ('[data:makeList]' 0 40 40 40 40 40 0)
  }
  return ('[data:makeList]' 0 0 0)
}

