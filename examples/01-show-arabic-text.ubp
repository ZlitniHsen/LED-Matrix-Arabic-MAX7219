  return ('[data:makeList]' 128 192 191 160)
}

to '_ar_glyph_alif_madda' form {
  '#' آ
  if (or (form == 0) (form == 1)) {
    return ('[data:makeList]' 2 1 61 1)
  }
  return ('[data:makeList]' 2 1 61 33)
}

to '_ar_glyph_alif_maqsura' form {
