to '_ar_glyph_high' code form {
  if (code == 1590) {return ('_ar_glyph_dad' form)}
  if (code == 1591) {return ('_ar_glyph_tah' form)}
  if (code == 1592) {return ('_ar_glyph_zah' form)}
  if (code == 1593) {return ('_ar_glyph_ain' form)}
  if (code == 1594) {return ('_ar_glyph_ghain' form)}
  if (code == 1600) {return ('_ar_glyph_tatweel' form)}
  if (code == 1601) {return ('_ar_glyph_fa' form)}
  if (code == 1602) {return ('_ar_glyph_qaf' form)}
  if (code == 1603) {return ('_ar_glyph_kaf' form)}
  if (code == 1604) {return ('_ar_glyph_lam' form)}
  if (code == 1605) {return ('_ar_glyph_meem' form)}
  if (code == 1606) {return ('_ar_glyph_noon' form)}
  if (code == 1607) {return ('_ar_glyph_ha_heh' form)}
  if (code == 1608) {return ('_ar_glyph_waw' form)}
  if (code == 1609) {return ('_ar_glyph_alif_maqsura' form)}
  if (code == 1610) {return ('_ar_glyph_ya' form)}
  if (code == 1642) {return ('[data:makeList]' 66 32 16 8 4 66)}
  return ('[data:makeList]' 0 0 0)
}

